---
import { url } from '../lib/site';

const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL || '/';

function current(href: string): boolean {
  const normalized = path.replace(/\/+$/, '') || '/';
  const target = href.replace(/\/+$/, '') || '/';
  if (target === (base.replace(/\/+$/, '') || '/')) {
    return normalized === target || normalized === '' || normalized === '/';
  }
  return normalized === target || normalized.startsWith(`${target}/`);
}

const home = url('');
const photos = url('photos/');
const writing = url('writing/');
const memes = url('memes/');
const socials = url('socials/');
const archive = url('archive/');
---

<header class="header">
  <div class="header-inner">
    <button
      type="button"
      class="theme-toggle"
      id="theme-toggle"
      data-next="light"
      aria-label="Switch to light theme"
    >
      <span class="theme-toggle-label" id="theme-toggle-label">Light</span>
      <span class="theme-toggle-icon" aria-hidden="true">
        <svg
          class="theme-icon theme-icon-sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
          ></path>
        </svg>
        <svg
          class="theme-icon theme-icon-moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </span>
    </button>
    <a class="wordmark" href={home}>Jakob Musk</a>
    <nav class="nav" aria-label="Primary">
      <div class="nav-row">
        <a href={home} aria-current={current(home) ? 'page' : undefined}>Home</a>
        <a href={photos} aria-current={current(photos) ? 'page' : undefined}>Images</a>
        <a href={writing} aria-current={current(writing) ? 'page' : undefined}>Writing</a>
        <a href={memes} aria-current={current(memes) ? 'page' : undefined}>Memes</a>
      </div>
      <div class="nav-row">
        <a href={socials} aria-current={current(socials) ? 'page' : undefined}>Contact</a>
        <a href={archive} aria-current={current(archive) ? 'page' : undefined}>Archive</a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var KEY = 'theme';
    var btn = document.getElementById('theme-toggle');
    var labelEl = document.getElementById('theme-toggle-label');
    if (!btn || !labelEl) return;

    function currentTheme() {
      var t = document.documentElement.getAttribute('data-theme');
      return t === 'light' ? 'light' : 'dark';
    }

    function syncButton(theme) {
      var next = theme === 'dark' ? 'light' : 'dark';
      var label = next === 'light' ? 'Light' : 'Dark';
      labelEl.textContent = label;
      btn.setAttribute('data-next', next);
      btn.setAttribute('aria-label', 'Switch to ' + next + ' theme');
      btn.setAttribute('aria-pressed', theme === 'light' ? 'true' : 'false');
    }

    function apply(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      try {
        localStorage.setItem(KEY, theme);
      } catch (e) {}
      var m = document.querySelector('meta[name="theme-color"]');
      if (m) m.setAttribute('content', theme === 'light' ? '#D4D4D2' : '#0a0a0a');
      syncButton(theme);
    }

    syncButton(currentTheme());

    btn.addEventListener('click', function () {
      apply(currentTheme() === 'dark' ? 'light' : 'dark');
    });
  })();
</script>
