---
/**
 * First-visit WIP notice. localStorage key: jakobmusk-wip-ok
 * Re-show: localStorage.removeItem('jakobmusk-wip-ok') then reload.
 * Dinamo-cookie style: lower-center cone + dialog. Wrapper is pointer-events:none
 * so the site stays usable; only the panel (cone/dialog/OK) captures clicks.
 * Shipped to prod with Jakob's green light.
 */
---

<div
  id="wip-overlay"
  class="wip-overlay"
  hidden
  role="dialog"
  aria-modal="false"
  aria-labelledby="wip-overlay-title"
  aria-describedby="wip-overlay-desc"
>
  <div class="wip-overlay__panel">
    <div class="wip-overlay__graphic" aria-hidden="true">
      <!-- Cute static traffic cone (original, not Dinamo) -->
      <svg
        class="wip-cone"
        viewBox="0 0 80 96"
        width="72"
        height="86"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <ellipse cx="40" cy="88" rx="28" ry="5" fill="#141414" opacity="0.12" />
        <path
          d="M18 82h44l-4.5-8H22.5L18 82Z"
          fill="#1a1a1a"
        />
        <path
          d="M24 74h32L48 22c-.4-2.2-2.3-3.8-4.5-3.8h-7c-2.2 0-4.1 1.6-4.5 3.8L24 74Z"
          fill="#F0A500"
        />
        <path
          d="M24 74h32L48 22c-.4-2.2-2.3-3.8-4.5-3.8h-7c-2.2 0-4.1 1.6-4.5 3.8L24 74Z"
          fill="url(#coneShade)"
        />
        <path
          d="M27.2 62h25.6l2.4-10H24.8l2.4 10Z"
          fill="#F7F2E8"
        />
        <path
          d="M29.8 48h20.4l2.2-9H27.6l2.2 9Z"
          fill="#F7F2E8"
        />
        <path
          d="M32.2 35h15.6l1.8-7.5c.15-.7-.3-1.3-.9-1.3H31.3c-.6 0-1.05.6-.9 1.3L32.2 35Z"
          fill="#F7F2E8"
        />
        <circle cx="40" cy="14" r="3.2" fill="#1a1a1a" />
        <path
          d="M40 11.2v-6.5"
          stroke="#1a1a1a"
          stroke-width="2.2"
          stroke-linecap="round"
        />
        <defs>
          <linearGradient id="coneShade" x1="28" y1="18" x2="56" y2="74" gradientUnits="userSpaceOnUse">
            <stop stop-color="#FFC24A" stop-opacity="0.35" />
            <stop offset="1" stop-color="#C47A00" stop-opacity="0.25" />
          </linearGradient>
        </defs>
      </svg>
    </div>

    <div class="wip-overlay__card">
      <h2 id="wip-overlay-title" class="wip-overlay__title">Work in progress</h2>
      <p id="wip-overlay-desc" class="wip-overlay__body">
        This site is still being built. Things may shift, break, or look half-finished — that’s expected.
      </p>
      <button type="button" class="wip-overlay__ok" data-wip-dismiss>
        OK
      </button>
    </div>
  </div>
</div>

<style>
  .wip-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 1.25rem;
    padding-bottom: max(1.75rem, env(safe-area-inset-bottom, 0px));
    /* Site stays clickable/scrollable behind; only the panel is interactive. */
    pointer-events: none;
  }

  .wip-overlay[hidden] {
    display: none !important;
  }

  .wip-overlay__panel {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    width: min(100%, 24rem);
    pointer-events: auto;
    animation: wip-pop 0.35s ease-out;
  }

  @keyframes wip-pop {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.97);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wip-overlay__panel {
      animation: none;
    }
  }

  .wip-overlay__graphic {
    line-height: 0;
    filter: drop-shadow(0 6px 14px color-mix(in srgb, #141414 18%, transparent));
  }

  .wip-cone {
    display: block;
  }

  .wip-overlay__card {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background: #f5e36b;
    color: #141414;
    border: 2px solid #141414;
    border-radius: 2px;
    box-sizing: border-box;
    padding: 0.95rem 1.2rem 1rem;
    box-shadow: 4px 4px 0 #141414;
  }

  .wip-overlay__title {
    margin: 0 0 0.35rem;
    font-family: var(--wordmark, "Playfair Display", Georgia, serif);
    font-weight: 500;
    font-size: 1.35rem;
    letter-spacing: 0.01em;
    line-height: 1.2;
    color: #141414;
  }

  .wip-overlay__body {
    margin: 0 0 0.85rem;
    font-family: var(--sans, Inter, system-ui, sans-serif);
    font-size: 0.92rem;
    line-height: 1.5;
    color: #222;
  }

  .wip-overlay__ok {
    appearance: none;
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: center;
    margin-inline: auto;
    min-width: 4.5rem;
    padding: 0.45rem 1.15rem;
    border: 2px solid #141414;
    border-radius: 2px;
    background: #141414;
    color: #f5e36b;
    font-family: var(--sans, Inter, system-ui, sans-serif);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .wip-overlay__ok:hover {
    opacity: 0.88;
  }

  .wip-overlay__ok:active {
    transform: translateY(1px);
  }

  .wip-overlay__ok:focus-visible {
    outline: 2px solid #141414;
    outline-offset: 3px;
  }

  @media (max-width: 420px) {
    .wip-overlay {
      padding: 1rem;
      padding-bottom: max(1.25rem, env(safe-area-inset-bottom, 0px));
    }

    .wip-overlay__panel {
      width: 100%;
    }

    .wip-cone {
      width: 60px;
      height: 72px;
    }
  }
</style>

<script is:inline>
  (function () {
    var KEY = 'jakobmusk-wip-ok';
    var root = document.getElementById('wip-overlay');
    if (!root) return;

    var okBtn = root.querySelector('.wip-overlay__ok');

    function isDismissed() {
      try {
        return localStorage.getItem(KEY) === '1';
      } catch (e) {
        return false;
      }
    }

    function persist() {
      try {
        localStorage.setItem(KEY, '1');
      } catch (e) {}
    }

    function dismiss() {
      persist();
      root.hidden = true;
      document.removeEventListener('keydown', onKey);
    }

    function onKey(e) {
      if (e.key === 'Escape') {
        e.preventDefault();
        dismiss();
      }
    }

    function show() {
      root.hidden = false;
      document.addEventListener('keydown', onKey);
      if (okBtn) okBtn.focus({ preventScroll: true });
    }

    root.querySelectorAll('[data-wip-dismiss]').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        dismiss();
      });
    });

    if (!isDismissed()) {
      show();
    }
  })();
</script>
