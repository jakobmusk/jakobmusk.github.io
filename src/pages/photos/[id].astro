---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, photoSrc } from '../../lib/site';
import { formatDate } from '../../lib/dates';

export async function getStaticPaths() {
  const all = (await getCollection('photos')).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  // Prev/next follow Images listing order (exclude showInImages: false).
  const listed = all.filter((p) => p.data.showInImages !== false);

  return all.map((photo) => {
    const listedIndex = listed.findIndex((p) => p.id === photo.id);
    const inListing = listedIndex >= 0;
    const prevPhoto = inListing && listedIndex > 0 ? listed[listedIndex - 1] : null;
    const nextPhoto =
      inListing && listedIndex < listed.length - 1 ? listed[listedIndex + 1] : null;
    return {
      params: { id: photo.id },
      props: {
        photo,
        prev: prevPhoto
          ? { id: prevPhoto.id, title: prevPhoto.data.title }
          : null,
        next: nextPhoto
          ? { id: nextPhoto.id, title: nextPhoto.data.title }
          : null,
      },
    };
  });
}

const { photo, prev, next } = Astro.props;
const { Content } = await render(photo);
const prevHref = prev ? url(`photos/${prev.id}/`) : '';
const nextHref = next ? url(`photos/${next.id}/`) : '';
---

<Base title={photo.data.title} description={photo.data.caption}>
  <a class="back" href={url('photos/')}>Images</a>
  <article class="photo-stage">
    <div
      class="frame"
      data-photo-nav
      data-prev={prevHref || undefined}
      data-next={nextHref || undefined}
    >
      <img
        src={photoSrc(photo.data.image)}
        alt={photo.data.alt}
      />
      {
        prev && (
          <a
            class="photo-nav photo-nav-prev"
            href={prevHref}
            aria-label={`Previous: ${prev.title}`}
            title={prev.title}
          >
            <span aria-hidden="true">‹</span>
          </a>
        )
      }
      {
        next && (
          <a
            class="photo-nav photo-nav-next"
            href={nextHref}
            aria-label={`Next: ${next.title}`}
            title={next.title}
          >
            <span aria-hidden="true">›</span>
          </a>
        )
      }
    </div>
    <div class="photo-meta">
      <h1>{photo.data.title}</h1>
      <p class="when">
        <time datetime={photo.data.date.toISOString()}>{formatDate(photo.data.date)}</time>
        · {photo.data.album}
      </p>
      <p class="caption">{photo.data.caption}</p>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <script is:inline>
    (function () {
      var frame = document.querySelector('[data-photo-nav]');
      if (!frame) return;
      var prevHref = frame.getAttribute('data-prev');
      var nextHref = frame.getAttribute('data-next');
      if (!prevHref && !nextHref) return;
      document.addEventListener('keydown', function (e) {
        if (e.defaultPrevented) return;
        var t = e.target;
        var tag = (t && t.tagName) || '';
        if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
        if (t && t.isContentEditable) return;
        if (e.key === 'ArrowLeft' && prevHref) {
          window.location.href = prevHref;
        } else if (e.key === 'ArrowRight' && nextHref) {
          window.location.href = nextHref;
        }
      });
    })();
  </script>
</Base>
