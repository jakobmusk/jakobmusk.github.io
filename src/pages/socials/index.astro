---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, photoSrc } from '../../lib/site';
import { formatDate } from '../../lib/dates';

const entries = (await getCollection('socials')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base title="Contact" description="Contact.">
  <div class="wrap">
    <p class="page-kicker">Contact</p>
    <h1 class="page-title">Contact</h1>
    <div class="contact-links">
      <a
        class="instagram-link"
        href="https://www.instagram.com/jakobmusk"
        target="_blank"
        rel="noreferrer"
        aria-label="Instagram — instagram.com/jakobmusk"
      >
        <svg
          class="instagram-frame"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 120 88"
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <!-- Rounded frame, hand-drawn wobble, slight overlap at top-right -->
          <path
            d="M 28 3.5
               C 42 1.8 58 1.2 74 1.6
               C 88 2 100 3.5 108 8
               C 115 12.5 118.5 20 119 30
               C 119.5 42 119 54 116.5 64
               C 114 72 106 79 94 82
               C 80 85.5 64 86.5 50 86
               C 34 85.5 20 81.5 12 74
               C 5 67 2 56 1.8 44
               C 1.5 30 3 18 8 11
               C 12 6 20 3.5 28 3.5
               C 36 2.8 48 2.2 58 2.4
               C 66 2.5 74 3 80 4.2"
            stroke="currentColor"
            stroke-width="3.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <!-- Stickman head (flattened, slightly wobbly oval) -->
          <path
            d="M 44 24
               C 44.5 17.5 50 14.2 58 14
               C 66.5 13.8 72.5 17 73 23.5
               C 73.4 30 67.5 34.2 58.2 34.4
               C 49.5 34.6 43.6 30.2 44 24 Z"
            stroke="currentColor"
            stroke-width="3.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <!-- Eyes -->
          <circle cx="52.2" cy="22.8" r="1.35" fill="currentColor" stroke="none" />
          <circle cx="64.5" cy="22.6" r="1.35" fill="currentColor" stroke="none" />
          <!-- Mouth (slight smile) -->
          <path
            d="M 51.5 28.2 C 55 30.2 61 30.4 66.5 28.6"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"
          />
          <!-- Torso -->
          <path
            d="M 58 33.5 L 57.2 72"
            stroke="currentColor"
            stroke-width="3.2"
            stroke-linecap="round"
          />
          <!-- Left arm (up-out) -->
          <path
            d="M 57.5 46 L 36 36.5"
            stroke="currentColor"
            stroke-width="3.2"
            stroke-linecap="round"
          />
          <!-- Right arm (down-out) -->
          <path
            d="M 57.6 49.5 L 74 55"
            stroke="currentColor"
            stroke-width="3.2"
            stroke-linecap="round"
          />
        </svg>
        <span class="instagram-label">Instagram</span>
      </a>
      <a
        class="xtwitter-link"
        href="https://x.com/jakobmusk"
        target="_blank"
        rel="noreferrer"
        aria-label="X/Twitter — x.com/jakobmusk"
      >
        <svg
          class="xtwitter-mark"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 100 112"
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <!-- Shine rays — float above; clear gap from X (X top ~y=40) -->
          <path
            d="M 11 14 C 7 9 4 5 1.5 1.5"
            stroke="currentColor"
            stroke-width="2.45"
            stroke-linecap="round"
          />
          <path
            d="M 29 11 C 25.5 7 22.5 3.5 19.5 1"
            stroke="currentColor"
            stroke-width="2.45"
            stroke-linecap="round"
          />
          <path
            d="M 50 9.5 C 50.1 6 50.25 3 50.35 0.5"
            stroke="currentColor"
            stroke-width="2.55"
            stroke-linecap="round"
          />
          <path
            d="M 71 11 C 74.5 7 78 3.5 81.5 1"
            stroke="currentColor"
            stroke-width="2.45"
            stroke-linecap="round"
          />
          <path
            d="M 87 14 C 91.5 9 95.5 5 98.5 1.5"
            stroke="currentColor"
            stroke-width="2.45"
            stroke-linecap="round"
          />
          <!-- Thick hollow bar NE–SW: block letter, flat terminals, light wobble -->
          <path
            d="M 55.5 40
               L 77.5 48
               C 78.2 48.4 78.4 49.2 78 50
               C 76.8 52.2 74.5 55.5 71.5 60
               C 62 75 46 92 29.5 105.5
               C 28.6 106.2 27.4 106.4 26.4 105.9
               L 22 104
               L 7 95.5
               C 6.2 95 6.1 93.9 6.7 93.2
               C 10 89.5 15 83 20.5 76
               C 32 61 45.5 48.5 53.5 41.5
               C 54.2 40.8 54.8 40.3 55.5 40 Z"
            stroke="currentColor"
            stroke-width="3.25"
            stroke-linecap="butt"
            stroke-linejoin="round"
          />
          <!-- Intersecting NW–SE stroke through the hollow channel -->
          <path
            d="M 20 41
               C 28 50 40 64 50 76
               C 60 88 72 100 86 110"
            stroke="currentColor"
            stroke-width="3.5"
            stroke-linecap="round"
          />
        </svg>
        <span class="xtwitter-label">X/Twitter</span>
      </a>
      <a
        class="soundcloud-link"
        href="https://soundcloud.com/jakobmusk"
        target="_blank"
        rel="noreferrer"
        aria-label="SoundCloud — soundcloud.com/jakobmusk"
      >
        <svg
          class="soundcloud-ear"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 100 145"
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <!-- Outer helix — cut short (no bottom return); thinner strokes -->
          <path
            d="M 75 33
               C 71 11 52 3 34 14
               C 16 26 9 52 12 78
               C 13.5 92 17 102 24 108"
            stroke="currentColor"
            stroke-width="2.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <!-- Inner fold — parallel under top/left of helix -->
          <path
            d="M 60 36
               C 50 30 38 35 34 48
               C 30 62 32 74 38 82"
            stroke="currentColor"
            stroke-width="2.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <!-- S-shaped inner hollow -->
          <path
            d="M 66 50
               C 52 48 44 58 50 68
               C 56 78 48 90 58 98"
            stroke="currentColor"
            stroke-width="2.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <!-- Short detached lower lobe — light incomplete sweep -->
          <path
            d="M 56 124
               C 62 130 72 126 78 116"
            stroke="currentColor"
            stroke-width="2.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <span class="soundcloud-label">SoundCloud</span>
      </a>
      <span class="contact-phone-wink">if you must (435) 555-5555</span>
    </div>
    <ul class="meme-grid">
      {
        entries.map((entry) => (
          <li>
            <a href={url(`socials/${entry.id}/`)} class="meme-card">
              <img
                src={photoSrc(entry.data.image)}
                alt={entry.data.alt}
                loading="lazy"
              />
              <div class="meme-card-meta">
                <h2>{entry.data.title}</h2>
                <time datetime={entry.data.date.toISOString()}>
                  {formatDate(entry.data.date)}
                </time>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
